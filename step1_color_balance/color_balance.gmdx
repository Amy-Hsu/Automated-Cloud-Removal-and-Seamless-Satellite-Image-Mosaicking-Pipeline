			<Data>
				<StringValue>CONDITIONAL { ($n50_temp &lt; $n58_Float) 1 ,
	(($n50_temp >= $n58_Float) &amp;&amp; ($n50_temp &lt; 0.0)) 2 ,
	($n50_temp == 0.0) 3,
